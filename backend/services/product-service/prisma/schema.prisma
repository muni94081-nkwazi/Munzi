generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Category (unlimited nesting via self-relation) ──────────────────────────
model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  level       Int        @default(0)   // 0 = root, 1 = sub, 2 = sub-sub...
  path        String     @default("")  // e.g. "/electronics/phones/android"
  sortOrder   Int        @default(0)
  /// Commission percentage charged to sellers listing under this category.
  /// The admin panel has always edited this; there was no column to store it,
  /// so every edit was silently discarded on save.
  commissionFeePercent Decimal @default(0) @db.Decimal(5, 2)
  active      Boolean    @default(true)
  products    Product[]
  attributes  CategoryAttribute[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([slug])
  @@index([path])
}

// ── Product ──────────────────────────────────────────────────────────────────
model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  description   String?
  sellerId      String
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  // Defaults to PENDING_APPROVAL, not ACTIVE: a listing reaches customers only
  // after an admin moderates it. The default matters beyond the service layer —
  // a bulk import or a manual INSERT that omits `status` must not publish a
  // product straight to the storefront.
  status        ProductStatus    @default(PENDING_APPROVAL)

  // ── Moderation ──────────────────────────────────────────────────────────
  rejectionReason String?
  moderatedAt     DateTime?
  moderatedBy     String?        // admin user id, from the gateway-stamped x-user-id
  submittedAt     DateTime?      // when it last entered PENDING_APPROVAL — queue ordering

  /// The seller's product-level list price. Seller-entered, never derived.
  basePrice     Decimal          @db.Decimal(12, 2)
  /// Cheapest ACTIVE variant price — server-maintained, never seller-supplied.
  ///
  /// Display and filtering disagreed without this. formatProduct shows the
  /// cheapest variant ('from UGX 31,000') while both query paths filtered and
  /// sorted on basePrice, so a product displayed at 31,000 was missed by
  /// maxPrice=35000 and ordered by a price the shopper never saw. Kept as a
  /// separate column so basePrice keeps meaning what the seller typed.
  ///
  /// Nullable only so the migration can backfill; every write sets it.
  minVariantPrice Decimal?       @db.Decimal(12, 2)
  compareAtPrice Decimal?        @db.Decimal(12, 2)
  currency      String           @default("UGX")
  brand         String?
  tags          String[]         @default([])
  images        String[]         @default([])
  averageRating Float            @default(0)
  reviewCount   Int              @default(0)
  viewCount     Int              @default(0)
  /// Product condition grading
  condition     ProductCondition @default(NEW)
  /// Minimum order quantity (B2B wholesale). Null = default (1).
  moq           Int?
  /// Wholesale volume pricing tiers: [{ minQty: number, price: number, label?: string }]
  wholesaleTiers Json?
  /// Multi-vendor aggregated offer pricing
  minOfferPrice Decimal?       @db.Decimal(12, 2)
  maxOfferPrice Decimal?       @db.Decimal(12, 2)
  activeOfferCount Int           @default(0)
  variants      ProductVariant[]
  specifications ProductSpecification[]
  offers        ProductOffer[]
  reviews       Review[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Composite indexes
  @@index([status, createdAt(sort: Desc)])            // default browse + "newest"
  @@index([status, categoryId, basePrice])            // category page + legacy price sort
  @@index([status, minVariantPrice])                  // price filter + price sort
  @@index([status, minOfferPrice])                    // offer-aware price sort
  @@index([status, averageRating(sort: Desc)])        // "top rated"
  @@index([sellerId, status, createdAt(sort: Desc)])  // seller dashboard
  @@index([status, condition])                        // condition filter

  // Moderation queue: admins page through one status ordered oldest-first, so
  // the sort direction here is the opposite of the browse index above and a
  // separate index is warranted rather than reusing [status, createdAt DESC].
  @@index([status, submittedAt(sort: Asc)])

  // Retained: single-column lookups still used on their own.
  @@index([categoryId])
}

enum ProductStatus {
  PENDING_APPROVAL  // submitted by the seller, awaiting admin moderation
  ACTIVE            // approved and visible to customers
  REJECTED          // admin declined; rejectionReason explains why
  DRAFT             // seller's work in progress, never submitted
  ARCHIVED
  OUT_OF_STOCK
}

// ── ProductVariant (SKU-level) ────────────────────────────────────────────────
model ProductVariant {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String    @unique
  attributes    Json      @default("{}")  // {"color": "Red", "size": "M"}
  price         Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock         Int       @default(0)     // total physical stock
  reserved      Int       @default(0)     // held by active carts
  lowStockThreshold Int   @default(5)
  barcode       String?
  weightKg      Float?
  length        Float?    // cm
  width         Float?    // cm
  height        Float?    // cm
  images        String[]  @default([])
  active        Boolean   @default(true)
  reservations  InventoryReservation[]
  attributeValues VariantAttributeValue[]
  offers        ProductOffer[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([id, productId], name: "variant_product_unique")
  @@index([productId, active])          // variant lists for a product page
  @@index([active, stock])              // low-stock alerts filter on both
  @@index([barcode])
}

// ── ProductOffer (Multi-vendor seller listing) ────────────────────────────────
model ProductOffer {
  id                String                 @id @default(cuid())
  productId         String
  variantId         String
  sellerId          String
  sellerSku         String?
  price             Decimal                @db.Decimal(12, 2)
  compareAtPrice    Decimal?               @db.Decimal(12, 2)
  currency          String                 @default("UGX")
  condition         ProductCondition       @default(NEW)
  conditionNote     String?
  moq               Int                    @default(1)
  wholesaleTiers    Json?
  stock             Int                    @default(0)
  reserved          Int                    @default(0)
  lowStockThreshold Int                    @default(5)
  status            OfferStatus            @default(ACTIVE)
  isBuyBoxWinner    Boolean                @default(false)
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant         @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  reservations      InventoryReservation[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([sellerId, sellerSku])
  @@index([productId, status, price])
  @@index([variantId, status, price])
  @@index([sellerId, status])
  @@index([status, stock])
}

enum OfferStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  SUSPENDED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

// ── InventoryReservation (cart holds, expire in 15 min) ──────────────────────
model InventoryReservation {
  id          String            @id @default(cuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  offerId     String?
  offer       ProductOffer?     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  userId      String?           // null = guest session
  sessionId   String            // cart session or user ID string
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime          // now() + 15 minutes
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@index([variantId])
  @@index([offerId, status])
  @@index([expiresAt, status])   // index for fast expiry sweeps
  @@index([sessionId])
  @@index([sessionId, variantId])
}

// ── ProductQuarantineLog (Quarantined unverified products / zero-variant items) ──
model ProductQuarantineLog {
  id         String   @id @default(uuid())
  productId  String
  sellerId   String?
  reason     String
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([sellerId])
  @@index([reason])
}

// ── ImportJob (bulk product CSV/Excel upload tracking) ───────────────────────
model ImportJob {
  id             String        @id @default(cuid())
  sellerId       String
  fileName       String
  fileSize       Int           // bytes
  format         ImportFormat
  status         ImportStatus  @default(PENDING)
  totalRows      Int           @default(0)
  processedRows  Int           @default(0)
  successRows    Int           @default(0)
  errorRows      Int           @default(0)
  errorLog       Json          @default("[]")  // [{row, sku, error}]
  filePath       String        // temp upload path
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([sellerId])
  @@index([status])
}

enum ImportFormat {
  CSV
  XLSX
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL  // completed with some errors
}

// ── Review ────────────────────────────────────────────────────────────────────
model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  userName         String
  rating           Int      // 1-5
  title            String
  body             String
  verifiedPurchase Boolean  @default(false)
  helpful          Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([rating])
}

// ── ProductCondition ─────────────────────────────────────────────────────────
enum ProductCondition {
  NEW
  REFURBISHED
  USED_LIKE_NEW
  USED_GOOD
  USED_FAIR
  OPEN_BOX
  FOR_PARTS
}

// ── AttributeType ────────────────────────────────────────────────────────────
enum AttributeType {
  TEXT
  NUMBER
  ENUM
  BOOLEAN
  COLOR
  DATE
}

// ── CategoryAttribute (attribute template defined per category) ──────────────
model CategoryAttribute {
  id             String                 @id @default(cuid())
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String                 // e.g. "Screen Size", "RAM", "Color"
  slug           String                 // e.g. "screen-size", "ram", "color"
  type           AttributeType          @default(TEXT)
  allowedValues  Json?                  // ["Red", "Blue", "Green"] for ENUM type
  unit           String?                // "inches", "GB", "kg"
  isVariantAxis  Boolean                @default(false)  // true = generates variant combinations
  isFilterable   Boolean                @default(true)   // true = search filter facet
  isRequired     Boolean                @default(false)  // true = mandatory on listing
  sortOrder      Int                    @default(0)
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  values         VariantAttributeValue[]

  @@unique([categoryId, slug])
  @@index([categoryId, active, sortOrder])
}

// ── ProductSpecification (free-form key-value specs grouped by section) ──────
model ProductSpecification {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key        String   // e.g. "Battery Capacity"
  value      String   // e.g. "5000mAh"
  group      String   @default("General")  // e.g. "Technical", "Physical", "Warranty"
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([productId, key])
  @@index([productId])
}

// ── VariantAttributeValue (typed, validated attribute values per variant) ────
model VariantAttributeValue {
  id           String             @id @default(cuid())
  variantId    String
  variant      ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    CategoryAttribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String             // typed value serialized as string
  createdAt    DateTime           @default(now())

  @@unique([variantId, attributeId])
  @@index([attributeId, value])
}
