# Expo reads runtime config from app.json's `expo.extra` block (see src/api/client.ts),
# not from a .env file loaded at build time. To point the app at a different backend:
#
# 1. Edit `extra.apiBaseUrl` in app.json, OR
# 2. For per-environment builds, use `app.config.js` + EAS environment variables:
#    https://docs.expo.dev/build-reference/variables/
#
# Local backend default used by this project:
API_BASE_URL=http://localhost:5000/api
